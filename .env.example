# Variables públicas para el cliente de Supabase (T03).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor: permite invocar la RPC de órdenes. Nunca usar prefijo NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# Solo servidor: secreto con el que se deriva (HMAC-SHA256) el token público de cada orden.
# Obligatorio en producción (sin él la creación de órdenes falla con 503); en desarrollo se usa un valor local.
# Generá uno largo y aleatorio, por ejemplo con: openssl rand -base64 32
CHECKOUT_TOKEN_SECRET=

# Supuesto configurable de demostración; no representa una política real de C3.
DEMO_COMMISSION_PERCENT=5
NEXT_PUBLIC_DEMO_COMMISSION_PERCENT=5

# URL canónica usada por metadata, sitemap y enlaces de confirmación.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Correo de confirmación de compra con Brevo (solo servidor; nunca con prefijo NEXT_PUBLIC_).
# Clave de la API transaccional de Brevo. Sin ella el correo no sale, pero la compra se confirma igual.
BREVO_API_KEY=
# Remitente verificado en Brevo (dominio autenticado con SPF y DKIM), por ejemplo una dirección no-reply del dominio del sitio.
BREVO_SENDER_EMAIL=
# Nombre que ve el comprador en el remitente. Opcional.
BREVO_SENDER_NAME=Ticketera C3 DEMO
# Solo servidor: protege la ejecución diaria de recordatorios y novedades.
CRON_SECRET=
# Wompi El Salvador en modo de prueba (solo servidor; nunca con prefijo NEXT_PUBLIC_).
# WOMPI_ENV debe ser exactamente sandbox. Cualquier otro valor bloquea los pagos con Wompi.
WOMPI_ENV=sandbox
WOMPI_APP_ID=
WOMPI_API_SECRET=
# Clave de 32 bytes en base64 para cifrar el token de checkout guardado en la base (AES-256-GCM).
# Generala con: openssl rand -base64 32
CHECKOUT_TOKEN_ENCRYPTION_KEY=
